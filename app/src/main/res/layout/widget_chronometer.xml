<?xml version="1.0" encoding="utf-8"?>
<!-- Rest/work countdown on the widget (F5.6): ticks on its own, with no widget updates.
     Large and light (spec display.xl); system font, since widgets can't use bundled fonts. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chronometer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:countDown="true"
    android:fontFamily="sans-serif-light"
    android:fontFeatureSettings="tnum"
    android:gravity="center"
    android:includeFontPadding="false"
    android:letterSpacing="-0.03"
    android:textSize="72sp" />
