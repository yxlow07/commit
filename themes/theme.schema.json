{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commit.yxuan.dev/themes/theme.schema.json",
  "title": "Commit theme",
  "description": "Design values for the Commit app and web app (F9.1), version 2: the design spec's colour tokens. No code. Missing values are filled from Light (light set) or Dark (dark set).",
  "type": "object",
  "required": [
    "schemaVersion",
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "light"
      ]
    },
    {
      "required": [
        "dark"
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "light": {
      "$ref": "#/$defs/colors"
    },
    "dark": {
      "$ref": "#/$defs/colors"
    },
    "shape": {
      "type": "object",
      "properties": {
        "cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "font": {
      "enum": [
        "default",
        "serif",
        "mono",
        "rounded"
      ]
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "colors": {
      "type": "object",
      "properties": {
        "ink": {
          "$ref": "#/$defs/color"
        },
        "onInk": {
          "$ref": "#/$defs/color"
        },
        "textStrong": {
          "$ref": "#/$defs/color"
        },
        "muted": {
          "$ref": "#/$defs/color"
        },
        "faint": {
          "$ref": "#/$defs/color"
        },
        "track": {
          "$ref": "#/$defs/color"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "danger": {
          "$ref": "#/$defs/color"
        },
        "scrim": {
          "$ref": "#/$defs/color"
        }
      }
    }
  }
}
